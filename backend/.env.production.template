# Optional overrides for Docker Compose (repository root). Local dev works without this file—compose defaults are enough.
# Use either or both:
# - Copy to `.env` at the repository root (Compose loads it automatically), and/or
# - Copy to `backend/.env.production` (sourced by `./run-server.sh` before `docker compose up`).
#
# JWT Authentication Secret Key (minimum 32 characters recommended)
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# Budget Default User Credentials
BUDGET_USER=admin
BUDGET_PASSWORD=admin

# Database Connection (if you want to override the default)
# Uncomment to use custom database settings
# DB_HOST=budget-db
# DB_PORT=5432
# DB_NAME=budget-sqldb
# DB_USER=postgres
# DB_PASSWORD=postgrespw

# ASP.NET Core Environment
# Options: Development, Staging, Production
# ASPNETCORE_ENVIRONMENT=Production

