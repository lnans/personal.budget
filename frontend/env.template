# The repo already includes `frontend/.env` for local dev; copy this file over `.env` only to recreate or customize.
#
# For production Docker builds, copy .env.production.template to .env.production (gitignored).
# From the repo root, ./run-server.sh exports (in order): .env, backend/.env.production,
# then frontend/.env.production if present, else frontend/.env.
# Vite reads these at build time; use the URL where the browser will reach the API.
VITE_API_URL=http://127.0.0.1:8080
VITE_LIST_PAGE_SIZE=10
